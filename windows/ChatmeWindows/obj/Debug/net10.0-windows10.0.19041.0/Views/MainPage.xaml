<Page
    x:Class="ChatmeWindows.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ChatmeWindows.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Custom ScrollViewer Style for hiding scrollbars until hover -->
        <Style TargetType="ListView">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:ConnectionId='2' x:Name="MainNav" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed"                                            >
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Паёмҳо" Tag="Messages">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F2;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem Content="Чустуҷӯ" Tag="Explore">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Меҳмонон" Tag="Guests">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Voice Rooms" Tag="VoiceRooms">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE1D6;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem Content="Панели администратор" Tag="Admin">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7EF;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Тамос бо админ" Tag="ContactAdmin">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F6;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Забон" Tag="Language">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE12B;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:ConnectionId='3' Content="Мавзӯъ" Tag="Theme"                             >
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE706;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar (Left Pane) -->
                <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Profile Header With Stats (Coins/XP) -->
                    <Grid Padding="16,16,16,8" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <PersonPicture x:ConnectionId='55' x:Name="MyAvatar" Width="48" Height="48" Grid.Column="0" ProfilePicture="ms-appx:///Assets/placeholder.png"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <!-- User Name -->
                            <TextBlock x:ConnectionId='58' x:Name="MyNameText" Text="Chatme Support" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                            
                            <!-- Stats Badge Area -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="12">
                                <!-- Coins -->
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="🟠" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock x:ConnectionId='60' x:Name="MyCoinsText" Text="1441" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <!-- XP -->
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="⚡" FontSize="10" Foreground="#d946ef" VerticalAlignment="Center"/>
                                    <TextBlock x:ConnectionId='59' x:Name="MyXpText" Text="1220" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Actions / Menu -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Button Background="Transparent" BorderThickness="0" Padding="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:ConnectionId='56' Text="My Profile" Tag="Profile"                                          >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem x:ConnectionId='57' x:Name="LogoutMenuItem" Text="Logout"                             >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF3B1;" FontFamily="Segoe Fluent Icons"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Grid>

                        <!-- Search Bar -->
                        <Grid Grid.Row="1" Padding="16,0,16,12">
                            <TextBox x:ConnectionId='54' x:Name="SearchBox" PlaceholderText="Search chats..." CornerRadius="16">
                                <TextBox.Header>
                                    <ContentPresenter Visibility="Collapsed"/>
                                </TextBox.Header>
                                <!-- Note: Proper search icon placement depends on WinUI version, using Placeholder as simple alternative -->
                            </TextBox>
                        </Grid>

                        <!-- Conversation List -->
                        <ListView x:ConnectionId='45' x:Name="ChatListView" Grid.Row="2"                                                  Padding="8,0,8,0">
                            <ListView.ItemTemplate>
                                <DataTemplate                                         >
                                    <Grid x:ConnectionId='47' Padding="8" CornerRadius="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <PersonPicture x:ConnectionId='48' Grid.Column="0" Height="48" Width="48"                                                                        />

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:ConnectionId='52'                             FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:ConnectionId='53'                             FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Time & Badge -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Right">
                                            <TextBlock x:ConnectionId='49'                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                                            <Border x:ConnectionId='50' Background="#ef4444" CornerRadius="10" MinWidth="20" Height="20" 
                                                    HorizontalAlignment="Right" Margin="0,6,0,0"                                       >
                                                <TextBlock x:ConnectionId='51'                                 Foreground="White" FontSize="11" FontWeight="Bold" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,0,12"/>
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>

                <!-- Main Content Area (Right Pane) -->
                <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Tab Tabs -->
                        <RowDefinition Height="Auto"/> <!-- Explore Header -->
                        <RowDefinition Height="*"/>    <!-- Content Area -->
                    </Grid.RowDefinitions>

                    <!-- Web-style Tabs (Users / Community) -->
                    <Grid x:ConnectionId='4' Grid.Row="0" x:Name="TabSelectorGrid" Margin="24,24,24,0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="16" Padding="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button x:ConnectionId='43' x:Name="UsersTabButton" Grid.Column="0" Content="👥 Корбарон" HorizontalAlignment="Stretch" Padding="12" CornerRadius="12" Background="{ThemeResource SystemAccentColorBrush}" Foreground="White" FontWeight="SemiBold"                        />
                        <Button x:ConnectionId='44' x:Name="CommunityTabButton" Grid.Column="1" Content="📱 Ҷамъият" HorizontalAlignment="Stretch" Padding="12" CornerRadius="12" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"                        />
                    </Grid>

                    <!-- VIEW: EXPLORE -->
                    <Grid x:ConnectionId='5' x:Name="ExploreView" Grid.Row="1" Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Explore Header -->
                            <RowDefinition Height="*"/>    <!-- Content Area -->
                        </Grid.RowDefinitions>

                        <!-- Explore Header -->
                        <Grid Grid.Row="0" Padding="24,32,24,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Чустуҷӯи корбарон" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock x:ConnectionId='42' x:Name="UserCountText" Text="... корбар ёфт шуд" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <Button x:ConnectionId='41' x:Name="RandomConnectButton" Padding="16,10" CornerRadius="12" Background="{StaticResource PrimaryGradient}" BorderThickness="0"                                  >
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE1D6;" FontSize="16" Foreground="White"/>
                                                <TextBlock Text="Пайвастшавии тасодуфӣ" Foreground="White" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                        
                                        <Button Content="Филтрҳо" Padding="16,10" CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Padding="24,0,24,24">
                            <ItemsControl x:ConnectionId='30' x:Name="UsersGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate                                        >
                                        <Border x:ConnectionId='32' Margin="12" Width="300" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="20" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Padding="24">
                                            <StackPanel Spacing="16">
                                                <!-- Avatar & Status -->
                                                <Grid HorizontalAlignment="Center">
                                                    <PersonPicture x:ConnectionId='39' Width="100" Height="100"                                 />
                                                    <Ellipse x:ConnectionId='40' Width="18" Height="18" Fill="#22c55e" Stroke="{ThemeResource LayerFillColorDefaultBrush}" StrokeThickness="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,8"                                         />
                                                </Grid>

                                                <!-- User Info -->
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <TextBlock x:ConnectionId='36'                      FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                        <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="8" Padding="8,4" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE819;" FontSize="12" Foreground="{ThemeResource SystemAccentColorBrush}"/>
                                                                <TextBlock x:ConnectionId='38'                              FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="•" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock x:ConnectionId='37'                        FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Bio -->
                                                <TextBlock x:ConnectionId='33'                     FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" MaxLines="3" Height="60"/>

                                                <!-- Languages (Native) -->
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE12B;" FontSize="14" Foreground="{ThemeResource SystemAccentColorBrush}"/>
                                                        <TextBlock Text="Забони модарӣ:" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    </StackPanel>
                                                    <Border Padding="8,4" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                        <TextBlock x:ConnectionId='35'                                FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Send Message Button -->
                                                <Button x:ConnectionId='34' HorizontalAlignment="Stretch" Padding="0,12" CornerRadius="12" Background="{StaticResource PrimaryGradient}" BorderThickness="0" Margin="0,8,0,0"
                                                                                                       >
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE724;" FontSize="16" Foreground="White" RenderTransformOrigin="0.5,0.5">
                                                            <FontIcon.RenderTransform>
                                                                <RotateTransform Angle="-45"/>
                                                            </FontIcon.RenderTransform>
                                                        </FontIcon>
                                                        <TextBlock Text="Паём навиштан" Foreground="White" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW: COMMUNITY -->
                    <Grid x:ConnectionId='6' x:Name="CommunityView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
                        <TextBlock Text="Ҷамъият (Дар ҳоли таҳия)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Opacity="0.5"/>
                    </Grid>

                    <!-- VIEW: GUESTS -->
                    <Grid x:ConnectionId='7' x:Name="GuestsView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Padding="24,32,24,16">
                            <TextBlock Text="Меҳмонони охирин" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Padding="24,0,24,24">
                            <ItemsControl x:ConnectionId='23' x:Name="GuestsGrid">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate                                  >
                                        <Border x:ConnectionId='25' Margin="0,0,0,8" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <PersonPicture x:ConnectionId='26' Grid.Column="0" Width="40" Height="40"                                    />
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:ConnectionId='28'                            FontWeight="SemiBold"/>
                                                    <TextBlock x:ConnectionId='29'                                FontSize="12" Opacity="0.6"/>
                                                </StackPanel>
                                                <TextBlock x:ConnectionId='27' Grid.Column="2"                               VerticalAlignment="Center" Opacity="0.7"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW: VOICEROOMS -->
                    <Grid x:ConnectionId='8' x:Name="VoiceRoomsView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <FontIcon Glyph="&#xE1D6;" FontSize="64" Opacity="0.2"/>
                            <TextBlock Text="Voice Rooms" FontSize="24" FontWeight="Bold" Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ин хусусият дар версияҳои оянда дастрас хоҳад шуд" FontSize="14" Opacity="0.4" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- VIEW: MESSAGES (Active Chat) -->
                    <Grid x:ConnectionId='9' x:Name="MessagesView" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <!-- Empty State (When no chat selected) -->
                        <Grid x:ConnectionId='10' x:Name="EmptyChatState" Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <FontIcon Glyph="&#xE119;" FontSize="64" Opacity="0.2"/>
                                <TextBlock Text="Барои оғози чат касеро интихоб кунед" FontSize="16" Opacity="0.5"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:ConnectionId='11' x:Name="ActiveChatContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Chat Header -->
                            <Border Grid.Row="0" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <PersonPicture x:ConnectionId='20' x:Name="ActiveChatAvatar" Grid.Column="0" Height="40" Width="40" />
                                    
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='21' x:Name="ChatHeaderName" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:ConnectionId='22' x:Name="ChatHeaderStatus" Text="Online" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button Background="Transparent" BorderThickness="0" Padding="10">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE717;" FontSize="16"/>
                                        </Button>
                                        <Button Background="Transparent" BorderThickness="0" Padding="10">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Messages Area -->
                            <ListView x:ConnectionId='12' x:Name="MessageListView" Grid.Row="1" Padding="16,16,16,8">
                                <ListView.ItemTemplate>
                                    <DataTemplate                                    >
                                        <Grid x:ConnectionId='16' Margin="0,4,0,4">
                                            <!-- Message Bubble -->
                                            <Border x:ConnectionId='17'                                          
                                                                                          
                                                                                         
                                                                                      
                                                                                              
                                                    Padding="12,12" 
                                                    MaxWidth="500"
                                                    Margin="0,4,0,4">
                                                <StackPanel>
                                                    <TextBlock x:ConnectionId='18'                         TextWrapping="Wrap"                                 FontSize="15" LineHeight="24"/>
                                                    <!-- Time -->
                                                    <TextBlock x:ConnectionId='19'                            
                                                               FontSize="10" 
                                                                                               
                                                               HorizontalAlignment="Right" 
                                                               Margin="0,4,0,0" 
                                                               Opacity="0.8"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>

                            <!-- Input Area -->
                            <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="10" Margin="0,0,8,0">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE723;" FontSize="18"/>
                                    </Button>

                                    <TextBox x:ConnectionId='13' x:Name="MessageInput" Grid.Column="1" 
                                             PlaceholderText="Type a message..." 
                                             CornerRadius="24" 
                                             Padding="12,8,12,8"
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True" 
                                             MaxHeight="100"
                                                                           
                                             VerticalAlignment="Center"
                                             BorderThickness="1"
                                             BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>

                                    <Button x:ConnectionId='14' x:Name="SendButton" Grid.Column="2" 
                                            CornerRadius="20" Width="40" Height="40" Padding="0" 
                                            Margin="12,0,0,0"                          Background="{StaticResource PrimaryGradient}" Foreground="White" BorderThickness="0">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;" FontSize="16"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>

